import express from 'express';
const users = [{
    id:1,
    name:'Dev',
    email:'dev@abes.ac.in'
}]
const app = express();
const port = 3000;

app.get("/", (req,res)=> {
    res.send("Welcome to api");
});

app.get("/getusers", (req,res)=> {
    res.send(users);
});

app.use(express.json());  // build in midleware.

app.post("/api/users", (req,res)=> {  // post body mein data ko send karta hai..
    const bodydata = req.body;
    console.log(bodydata);
    res.send("Data received successfully");
});

app.post("/api/Createusers", (req,res)=> {  // post body mein data ko send karta hai..
    const {name,email} = req.body;
    const newid = users .length>0? users[users.length-1].id+1:1;
    users.push({id:newid,name,email});
    res.status(201).send("User Create successfully");
});
app.get("/getusers/:id", (req,res)=> {
    const {id} = req.params;
    const user = users.find(user => user.id == id);
    res.send(user);
});


app.listen(port,()=>{
    console.log(`Server is running on port ${port}`);
});
